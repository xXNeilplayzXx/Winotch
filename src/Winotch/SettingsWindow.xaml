<Window x:Class="Winotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winotch Settings" Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NotchPanel}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Winotch" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Settings apply live and persist to %LOCALAPPDATA%\Winotch\settings.json"
                       FontSize="11" Foreground="{StaticResource NotchMutedText}" Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="The notch shell: hover the pill to expand. Drag it to move."
                   FontSize="10.5" Foreground="{StaticResource NotchMutedText}" Margin="0,14,0,0" />
    </Grid>
</Window>
