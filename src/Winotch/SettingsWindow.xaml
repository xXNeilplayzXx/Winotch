<Window x:Class="Winotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winotch — Settings" Width="470" MinHeight="540" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NotchPanel}">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header: led + wordmark + version badge -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="11" Height="11" Fill="{StaticResource NotchAccent}" VerticalAlignment="Center" />
                <TextBlock Text="Winotch" FontSize="23" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="Settings" FontSize="23" Foreground="{StaticResource NotchMutedText}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border x:Name="VersionBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{StaticResource NotchPanelRaised}" BorderBrush="{StaticResource NotchStroke}"
                    BorderThickness="1" CornerRadius="9" Padding="10,4">
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource NotchMutedText}"
                           FontFamily="Consolas, Courier New" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" />
        </ScrollViewer>

        <!-- footer: persistence hint -->
        <Border Grid.Row="2" Background="{StaticResource NotchPanelRaised}"
                BorderBrush="{StaticResource NotchStroke}" BorderThickness="1"
                CornerRadius="10" Padding="13,9" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="11" Foreground="{StaticResource NotchAccent}"
                           VerticalAlignment="Top" Margin="0,1,9,0" />
                <StackPanel>
                    <TextBlock Text="Settings apply live" FontSize="11" Foreground="{StaticResource NotchText}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Stored as JSON at %LOCALAPPDATA%\Winotch\settings.json"
                               FontSize="10.5" Foreground="{StaticResource NotchMutedText}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>