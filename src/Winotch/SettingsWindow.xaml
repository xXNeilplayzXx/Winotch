<Window x:Class="Winotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winotch — Settings" Width="900" MinWidth="720" MinHeight="560" Height="660"
        WindowStartupLocation="CenterScreen"
        Icon="/Winotch;component/Resources/WinotchTray.ico"
        Background="{DynamicResource NotchPanel}">
    <!-- The reference settings sheet: one bordered card holding a rail of section
         names on the left and the selected section's pane on the right. -->
    <Border Margin="16" CornerRadius="22"
            Background="{DynamicResource NotchPanel}"
            BorderBrush="{DynamicResource NotchStroke}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- rail: status light + wordmark, the sections, the version badge -->
            <DockPanel Grid.Column="0" Margin="14,18,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,16">
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource NotchAccent}" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{DynamicResource NotchAccentColor}"
                                              BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Winotch" FontSize="15" FontWeight="Bold"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Border x:Name="VersionBadge" DockPanel.Dock="Bottom" HorizontalAlignment="Left"
                        Background="{DynamicResource NotchPanelRaised}"
                        BorderBrush="{DynamicResource NotchStroke}"
                        BorderThickness="1" CornerRadius="14"
                        Padding="10,4" Margin="6,10,0,0">
                    <TextBlock x:Name="VersionText" FontSize="11"
                               Foreground="{DynamicResource NotchMutedText}"
                               FontFamily="Consolas, Courier New" />
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavRail" />
                </ScrollViewer>
            </DockPanel>

            <!-- the hairline that separates rail from pane -->
            <Border Grid.Column="1" Background="{DynamicResource NotchStroke}" />

            <!-- pane: heading, rows, and the sticky action bar -->
            <DockPanel Grid.Column="2" Margin="28,20,24,16">
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource NotchPanelRaised}"
                        BorderBrush="{DynamicResource NotchStroke}" BorderThickness="1"
                        CornerRadius="14" Padding="13,9" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource NotchIconFont}"
                                       FontSize="11" Foreground="{DynamicResource NotchAccent}"
                                       VerticalAlignment="Top" Margin="0,1,9,0" />
                            <StackPanel>
                                <TextBlock Text="Settings apply live" FontSize="11" Foreground="{DynamicResource NotchText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Stored as JSON at %LOCALAPPDATA%\Winotch\settings.json"
                                           FontSize="10.5" Foreground="{DynamicResource NotchMutedText}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                <!-- Only shown when the icon font could not be resolved,
                                     so a window full of gaps explains itself. -->
                                <TextBlock x:Name="IconHint" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource NotchDanger}"
                                           Margin="0,4,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="FooterActions" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Rows" Margin="0,0,16,0" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
