<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Winotch</AssemblyName>
    <RootNamespace>Winotch</RootNamespace>
    <Version>2.3.3</Version>
    <Product>Winotch</Product>
    <ApplicationIcon>Resources/WinotchTray.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Always define WINDOWS for the Windows TFM -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Windows needs WinForms (tray icon, clipboard, power status, screens).
       WPF is deliberately absent: this is an Avalonia app, and mixing the two
       UI stacks in one process breaks Avalonia font/asset lookups. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="Tmds.DBus" Version="0.18.*" />
  </ItemGroup>

  <!-- The tray/window icon is read back by logical name from DialogUi and the
       tray service, so it must be embedded under that exact name. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/WinotchTray.ico" LogicalName="Winotch.Resources.WinotchTray.ico" />
  </ItemGroup>

  <!-- Exclude Windows-only files on non-Windows platforms -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="MediaService.cs" />
    <Compile Remove="WindowsLocation.cs" />
    <Compile Remove="Engine/BackdropBlur.cs" />
  </ItemGroup>

</Project>
