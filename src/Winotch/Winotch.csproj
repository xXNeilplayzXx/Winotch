<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- A separate WAP project adds package identity while the default build remains portable. -->
    <WindowsPackageType Condition="'$(WinotchMsix)' != 'true'">None</WindowsPackageType>
    <AppxPackageSigningEnabled Condition="'$(WinotchMsix)' != 'true'">false</AppxPackageSigningEnabled>
    <AssemblyName>Winotch</AssemblyName>
    <RootNamespace>Winotch</RootNamespace>
    <Version>4.5.0</Version>
    <Product>Winotch</Product>
    <ApplicationIcon>Resources\WinotchTray.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\WinotchTray.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
    <!-- The internal panel's brightness only exists behind ACPI, which on
         Windows means WMI's root\wmi:WmiMonitorBrightness. Managed only, so it
         bundles into Winotch.exe like the rest — the updater still has just the
         one file to swap. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF and WinForms are used side by side; drop the auto-global usings
         WinForms injects so common names (Application, Brush, CheckBox, …)
         resolve to the WPF types each file imports explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winotch.Tests" />
  </ItemGroup>

</Project>
