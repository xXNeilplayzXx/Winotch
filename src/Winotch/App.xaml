<Application x:Class="Winotch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- design tokens -->
        <SolidColorBrush x:Key="NotchBlack" Color="#050505" />
        <SolidColorBrush x:Key="NotchPanel" Color="#15171C" />
        <SolidColorBrush x:Key="NotchPanelRaised" Color="#1E2127" />
        <SolidColorBrush x:Key="NotchPanelHover" Color="#262A32" />
        <SolidColorBrush x:Key="NotchStroke" Color="#2E333C" />
        <SolidColorBrush x:Key="NotchAccent" Color="#50D6FF" />
        <SolidColorBrush x:Key="NotchOk" Color="#32D74B" />
        <SolidColorBrush x:Key="NotchDanger" Color="#FF6B6B" />
        <SolidColorBrush x:Key="NotchText" Color="#F4F6FA" />
        <SolidColorBrush x:Key="NotchMutedText" Color="#9AA3B2" />
        <SolidColorBrush x:Key="NotchHairline" Color="#23272F" />
        <!-- UI typeface, overridden at runtime by the Appearance font setting -->
        <FontFamily x:Key="NotchUiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <Style x:Key="GlyphText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{StaticResource NotchText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource NotchUiFont}" />
            <Setter Property="Foreground" Value="{StaticResource NotchText}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource NotchUiFont}" />
            <Setter Property="Foreground" Value="{StaticResource NotchText}" />
            <Setter Property="Background" Value="{StaticResource NotchPanelRaised}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NotchPanelHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NotchAccent}" />
            <Setter Property="Foreground" Value="#06131A" />
        </Style>

        <Style x:Key="RowLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource NotchMutedText}" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
        </Style>

        <Style x:Key="SectionLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource NotchMutedText}" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Dark checkbox: the stock white box looks out of place. The check
             glyph + accent fill only appear when checked. Implicit so every
             dialog (accent row, metrics, focus editor) picks it up; the
             NotchSwitch toggle style below is keyed and wins where applied. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource NotchText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                    Background="{DynamicResource NotchPanelHover}"
                                    BorderBrush="{DynamicResource NotchStroke}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" Foreground="#06131A" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource NotchAccent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource NotchAccent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark combo box for the font picker (dropdown chrome included). -->
        <Style x:Key="NotchCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource NotchText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding SelectionBoxItem}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource NotchPanelHover}"
                                                BorderBrush="{DynamicResource NotchStroke}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,5">
                                            <Grid>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  Foreground="{DynamicResource NotchText}"
                                                                  VerticalAlignment="Center" Margin="0,0,18,0" />
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="9" Foreground="{DynamicResource NotchMutedText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource NotchPanelRaised}"
                                        BorderBrush="{DynamicResource NotchStroke}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource NotchText}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                            Padding="10,6" Margin="3,1">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource NotchPanelHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource NotchAccent}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="#06131A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings toggle: an iOS-style switch (track + sliding knob). -->
        <Style x:Key="NotchSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                    Background="{DynamicResource NotchPanelHover}"
                                    BorderBrush="{DynamicResource NotchStroke}" BorderThickness="1" />
                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     Fill="{DynamicResource NotchMutedText}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource NotchAccent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource NotchAccent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="#06131A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
